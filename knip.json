{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": [".husky/**"]
    },
    "frontend": {
      "entry": ["src/app/**/*.{ts,tsx}", "src/**/route.ts", "scripts/check-contrast.mjs"],
      "project": ["src/**/*.{ts,tsx}", "src/**/*.test.ts"]
    },
    "backend": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [
    "frontend/src/components/layout/MobileTabBar.tsx",
    "frontend/src/components/layout/headerComponents/NavigationMenu.tsx",
    "frontend/src/components/layout/headerComponents/SearchInput.tsx",
    "frontend/src/components/layout/headerComponents/SearchInputMobile.tsx",
    "backend/src/tasks/tasks.module.ts"
  ],
  "ignoreBinaries": ["tsc", "prisma"],
  "ignoreDependencies": [
    "shadcn",
    "@reduxjs/toolkit",
    "react-redux",
    "react-easy-crop",
    "@nestjs/mapped-types",
    "cache-manager-redis-store",
    "text-transformer",
    "text-validator",
    "@svgr/webpack",
    "autoprefixer",
    "eslint-plugin-prettier",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "eslint-plugin-jsx-a11y",
    "tailwindcss",
    "tw-animate-css",
    "@eslint/eslintrc",
    "@types/multer",
    "@types/supertest",
    "source-map-support",
    "supertest",
    "ts-loader"
  ],
  "ignoreIssues": {
    "backend/src/friends/dto/get-friend.dto.ts": ["files"],
    "backend/src/utils/matches.utils.ts": ["types"],
    "frontend/src/hooks/**": ["exports", "duplicates"],
    "frontend/src/components/ui/**": ["exports", "types", "files"],
    "frontend/src/components/composites/**": ["exports", "types", "duplicates"],
    "frontend/src/components/layouts/**": ["exports"],
    "frontend/src/utils/sessionTime.ts": ["exports"],
    "frontend/src/components/profile/ProfileView.tsx": ["types"],
    "frontend/src/components/calendar/SessionDetails.tsx": ["types"],
    ".husky/pre-push": ["binaries"]
  }
}
