NODE_ENV=development
PORT=5200

# Postgres connection string (see docker-compose.yaml for local Postgres)
DATABASE_URL=postgresql://postgres:root@localhost:5432/skillswap?schema=public

JWT_SECRET=
JWT_REFRESH_SECRET=

# Frontend origin(s) allowed by CORS
CORS_ORIGIN=http://localhost:3000
# Where users land after a successful OAuth login
FRONTEND_URL=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — app runs single-instance/in-memory without these
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ADMIN_SECRET=
SENTRY_DSN=

# Google OAuth — optional, sign-in returns 503 when unset. See Google Cloud
# Console > APIs & Services > Credentials. Authorized redirect URI must match
# GOOGLE_CALLBACK_URL exactly (needs the /api prefix).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5200/api/auth/google/callback
